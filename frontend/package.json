{
  "name": "livemirror-frontend",
  "version": "1.0.0",
  "description": "LiveMirror Frontend with Dark Mode Support",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "echo 'Visual testing: Open dev server and verify all pages in light/dark mode'"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "axios": "^1.15.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "typescript": "5.3.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^1.8.0"
  },
  "keywords": [
    "livemirror",
    "dark-mode",
    "theme",
    "vue3"
  ],
  "author": "LiveMirror Team",
  "license": "MIT"
}
