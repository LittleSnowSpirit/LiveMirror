    },
    {
      "segment_id": 11,
      "start_time": "00:05:00",
      "end_time": "00:05:30",
      "content": "有宝宝说之前买贵了，那个我也没办法，今天是特殊活动价。",
      "word_count": 27,
      "speech_type": "待分析",
      "is_highlight": false,
