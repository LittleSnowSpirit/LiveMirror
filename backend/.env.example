# LiveMirror 后端环境变量示例
# 复制为 backend/.env 后，再填写真实值

# 可选模型服务
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# 服务运行
HOST=0.0.0.0
PORT=8000
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret

# 上传与分析
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2147483648
ALLOWED_EXTENSIONS=mp3,wav,m4a
TASK_WORKER_COUNT=2

# 数据库
DATABASE_URL=sqlite:///./livemirror.db

# 语音转写
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=base
WHISPER_LANGUAGE=zh

# 链接分析
YT_DLP_PATH=yt-dlp
DOWNLOAD_DIR=./uploads/downloads
MAX_DOWNLOAD_DURATION=600

# 日志
LOG_LEVEL=INFO
