DATABASE_URL=postgresql://livemirror:livemirror@postgres:5432/livemirror
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost,http://localhost:80

# Transcription Provider: local | mock | dashscope
TRANSCRIPTION_PROVIDER=local

# DashScope (Alibaba Cloud) — ASR + LLM
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=paraformer-v2

# AI Analysis
DEEPSEEK_API_KEY=

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@livemirror.com
